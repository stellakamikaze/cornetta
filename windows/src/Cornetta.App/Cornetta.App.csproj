<Project Sdk="Microsoft.NET.Sdk">
  <!--
    App per l'area di notifica. Gira su .NET Framework 4.8, già presente in Windows 10 (1903+) e 11:
    il pacchetto pesa pochi MB, non installa runtime e non chiede permessi di amministratore.
    Un'app .NET 8/10 self-contained supera i 60 MB e il Worker di Cloudflare accetta file fino a 25 MiB.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Cornetta</AssemblyName>
    <RootNamespace>Cornetta.App</RootNamespace>
    <ApplicationIcon>Assets\cornetta.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <AssemblyTitle>Cornetta</AssemblyTitle>
    <Description>Registratore di chiamate gratuito</Description>
    <!-- Numero di build mostrato nel feedback (il CI passa il numero della run). -->
    <CornettaBuild Condition="'$(CornettaBuild)' == ''">dev</CornettaBuild>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="CornettaBuild" Value="$(CornettaBuild)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cornetta.Core\Cornetta.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\cornetta.ico" LogicalName="Cornetta.cornetta.ico" />
    <EmbeddedResource Include="Assets\tray-idle.ico" LogicalName="Cornetta.tray-idle.ico" />
    <EmbeddedResource Include="Assets\tray-recording.ico" LogicalName="Cornetta.tray-recording.ico" />
    <EmbeddedResource Include="Assets\tray-update.ico" LogicalName="Cornetta.tray-update.ico" />
    <None Remove="Assets\icon.png" />
  </ItemGroup>
</Project>
